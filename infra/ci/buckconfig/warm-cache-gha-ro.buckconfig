# Opt-in GHA reader overlay — Access TCP forwarder on 127.0.0.1:55052.
# Canary / second-job warm probe. No upload default.
# Buck2 OSS: host:port (no grpcs://); materialize --profile writes daemon-visible .buckconfig.local
# (combined tls_client_cert PEM). --config-file alone is insufficient for REClientBuilder.

[buck2_re_client]
  engine_address = 127.0.0.1:55052
  cas_address = 127.0.0.1:55052
  action_cache_address = 127.0.0.1:55052
  instance_name = main
  tls = true

[cas_cache]
  remote_cache_enabled = true
  allow_cache_uploads = false

[build]
  execution_platforms = //infra/ci/buck2/cache:cache-platform
