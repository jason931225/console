# Opt-in WARM READ+WRITE overlay — shared laptop NativeLink CAS (oyatie-cas lab).
# Do NOT merge into root .buckconfig. Apply via:
#   tools/buck2 --config-file infra/ci/buckconfig/warm-cache-lab-rw.buckconfig …
# plus mode-0600 .buckconfig.local for mTLS paths (scripts/cas/materialize-buckconfig-local.sh).
#
# Fail-closed: do not treat remote hits as merge-required until integrity-canary GREEN
# and an explicit warm_reads license exists for console (mirror oyatie).

[buck2]
  default_allow_cache_upload = true

[buck2_re_client]
  # Local loopback writer (mTLS). GHA: forward Access TCP to 127.0.0.1:55051 and
  # override these addresses in the job (or use warm-cache-gha-rw.buckconfig).
  engine_address = grpcs://127.0.0.1:50051
  cas_address = grpcs://127.0.0.1:50051
  action_cache_address = grpcs://127.0.0.1:50051
  instance_name = main
  tls = true
