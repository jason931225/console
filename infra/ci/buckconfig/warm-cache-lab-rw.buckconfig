# Opt-in WARM READ+WRITE overlay — shared laptop NativeLink CAS (lab loopback).
# Do NOT merge into root .buckconfig. Apply via:
#   scripts/cas/materialize-buckconfig-local.sh --profile lab-rw
#   tools/buck2 --config-file infra/ci/buckconfig/warm-cache-lab-rw.buckconfig …
#
# Buck2 2026-07-15: addresses are host:port (no grpcs://). REClientBuilder reads
# daemon root config — materialize --profile writes addresses into .buckconfig.local
# (--config-file alone is insufficient for engine_address).
#
# Fail-closed: do not treat remote hits as merge-required until a cited warm canary
# and an explicit warm_reads license exists (mirror oyatie license posture).

[buck2]
  default_allow_cache_upload = true

[buck2_re_client]
  # Local loopback writer (mTLS). GHA: use warm-cache-gha-rw.buckconfig + Access TCP.
  engine_address = 127.0.0.1:50051
  cas_address = 127.0.0.1:50051
  action_cache_address = 127.0.0.1:50051
  instance_name = main
  tls = true

[cas_cache]
  remote_cache_enabled = true
  allow_cache_uploads = true

[build]
  execution_platforms = //infra/ci/buck2/cache:cache-platform
