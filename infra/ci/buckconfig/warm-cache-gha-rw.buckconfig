# Opt-in GHA writer overlay — expects Access TCP forwarder on 127.0.0.1:55051
# before Buck2 starts (scripts/cas/start-access-tcp.sh). Trusted workflows only.
# Buck2 OSS: host:port (no grpcs://); materialize --profile writes daemon-visible .buckconfig.local
# (combined tls_client_cert PEM). --config-file alone is insufficient for REClientBuilder.

[buck2]
  default_allow_cache_upload = true

[buck2_re_client]
  engine_address = 127.0.0.1:55051
  cas_address = 127.0.0.1:55051
  action_cache_address = 127.0.0.1:55051
  instance_name = main
  tls = true

[cas_cache]
  remote_cache_enabled = true
  allow_cache_uploads = true

[build]
  execution_platforms = //infra/ci/buck2/cache:cache-platform
