{
  "version": "1.0.0",
  "description": "Closed process learning loop for Console — edit workflows/tools, not product scope. Inspired by Bun rewrite + Hermes learning ideas without external CLIs.",
  "inspired_by": [
    "https://bun.com/blog/bun-in-rust",
    "oyatie .grok/harness/learning-loop.v1.json"
  ],
  "lanes": {
    "daily_reflection": {
      "path_template": ".grok/memory/reflections/{date}.md",
      "purpose": "What failed, which class, what control changed"
    },
    "setup_tip": {
      "path_template": ".grok/memory/tips/{slug}.md",
      "purpose": "Reusable operational prescription for a failure class"
    },
    "process_edit": {
      "path_template": ".grok/programs/evidence/process-edits-{date}.md",
      "purpose": "Record workflow/harness files changed for a class"
    }
  },
  "triggers": {
    "after_hard_fail": true,
    "after_repeat_failure_class": 2,
    "after_hosted_preflight_red": true,
    "after_passive_wait_incident": true
  },
  "actions": {
    "map_to_failure_class": true,
    "run_process_upgrade_workflow": true,
    "forbid_one_shot_hooks": true,
    "product_scope_unchanged": true
  },
  "process_edit_allowlist": [
    ".grok/workflows/**",
    ".grok/harness/**",
    ".grok/programs/**",
    "tools/ci/**",
    "scripts/console/**",
    "scripts/check-*.mjs",
    "package.json"
  ],
  "process_edit_forbidden": [
    "docs/current/**",
    "backend/crates/**",
    "deploy/**"
  ],
  "verified_empty_is_work": true
}
