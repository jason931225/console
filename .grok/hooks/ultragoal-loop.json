{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/bin/console-hook-session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/bin/console-hook-stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
