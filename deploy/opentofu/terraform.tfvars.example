# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
compartment_ocid = "ocid1.compartment.oc1..xxxx" # the 'prod' compartment
region           = "ap-chuncheon-1"

# Hardening: lock the Talos + k8s control-plane APIs to your admin /32.
admin_cidr = "203.0.113.10/32"

# Required — there is no default. The live node was created from this image and
# is irreplaceable, so an unset value must stop the plan, not silently drop it.
talos_image_ocid = "ocid1.image.oc1.ap-chuncheon-1.xxxx"
