# The audited object-policy attach writer, plus the five single-instance read
# paths that ignored the object policy entirely (a row hidden from the list was
# still fetchable by id, by as-of, by history, by traverse, by acting and by
# code). Wired here, in ci.yml, and in BOTH locked lists in
# scripts/check-ci-preflight.mjs at the same time: a rust_test with no sh_test
# wrapper resolves, builds, and never executes -- the false-green class this
# repo has already shipped six times.
sh_test(
    name = "ontology-object-policy-attach-postgres",
    test = "run_test_with_postgres_env.sh",
    args = ["$(location //backend/crates/ontology/rest:console-ontology-rest-itest-object_policy_attach_as_runtime_role)"],
    deps = ["//backend/crates/ontology/rest:console-ontology-rest-itest-object_policy_attach_as_runtime_role"],
    labels = ["test.integration", "resource.postgres", "needs-postgres"],
)

# The only committed proof that the instance READ path works: it publishes a
# type, seeds an enforced catalog row plus an attachment, and asserts the list
# returns EXACTLY the permitted rows as the genuine non-superuser `console_rt` --
# a forbid collapses it to `[]` and a cross-tenant type id is 404. Every claim
# this repo makes about policy-filtered reads rests on that test, and it had a
# `rust_test` target with no wrapper here and no ci.yml step, so it had never
# executed in CI. Third instance of the same defect after the two below.
sh_test(
    name = "ontology-object-type-cas-postgres",
    test = "run_test_with_postgres_env.sh",
