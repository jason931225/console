# Non-generated wrappers keep disposable PostgreSQL credential values out of
# Buck's test-executor argv.  The harness passes only a mode-0600 file path;
# this wrapper loads it inside the test process before executing the exact
# generated Rust integration-test binary.
sh_test(
    name = "pr473-ontology-key-revision-postgres",
    test = "run_test_with_postgres_env.sh",
    args = ["$(location //backend/crates/ontology/adapter-postgres:mnt-ontology-adapter-postgres-itest-key_revision_migration_upgrade)"],
    deps = ["//backend/crates/ontology/adapter-postgres:mnt-ontology-adapter-postgres-itest-key_revision_migration_upgrade"],
    labels = ["test.integration", "resource.postgres", "needs-postgres"],
)

